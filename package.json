{
  "name": "leafline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --persist-to .wrangler/state",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "preview": "vite preview",
    "deploy:worker": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply leafline-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply leafline-db --remote"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.30.0"
  }
}
